# Server
NODE_ENV=development
PORT=4000
CORS_ORIGIN=http://localhost:3000
COOKIE_DOMAIN=
COOKIE_SAME_SITE=lax
COOKIE_SECURE=false

# Database
DATABASE_URL=postgresql://appchat:appchat@localhost:5432/appchat?schema=public

# Redis
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# JWT (replace in production)
JWT_ACCESS_SECRET=dev-access-secret-change-me
JWT_ACCESS_TTL=900
JWT_REFRESH_SECRET=dev-refresh-secret-change-me
JWT_REFRESH_TTL=2592000

# KMS / encryption (32-byte base64 for dev only — use real KMS in prod)
DATA_ENCRYPTION_KEY=zT9Ks2lQv7N0pX3rA8mB4hY6eU1cF5wJ9oG2dV0iS8E=

# S3 / R2
S3_ENDPOINT=
S3_REGION=auto
S3_BUCKET=appchat-media
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Moderation (optional)
MODERATION_PROVIDER_URL=
MODERATION_PROVIDER_KEY=
