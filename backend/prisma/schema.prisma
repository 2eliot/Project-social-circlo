generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [citext, pg_trgm, pgcrypto]
}

model User {
  id                                                         String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                                                      String                @unique @db.Citext
  passwordHash                                               String                @map("password_hash")
  legalNameEncrypted                                         Bytes?                @map("legal_name_encrypted")
  dateOfBirth                                                DateTime              @map("date_of_birth") @db.Date
  displayName                                                String                @map("display_name") @db.VarChar(40)
  avatarUrl                                                  String?               @map("avatar_url")
  isAnonymousProfile                                         Boolean               @default(false) @map("is_anonymous_profile")
  globalRole                                                 GlobalRole            @default(USER) @map("global_role")
  isVerifiedModerator                                        Boolean               @default(false) @map("is_verified_moderator")
  isBanned                                                   Boolean               @default(false) @map("is_banned")
  bannedReason                                               String?               @map("banned_reason")
  createdAt                                                  DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt                                                  DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt                                                  DateTime?             @map("deleted_at") @db.Timestamptz(6)
  sessions                                                   AuthSession[]
  dmRequestsStarted                                          DirectConversation[]  @relation("DMInitiator")
  dmA                                                        DirectConversation[]  @relation("DMUserA")
  dmB                                                        DirectConversation[]  @relation("DMUserB")
  hiddenDirectMessages                                       DirectMessageHidden[]
  directMessages                                             DirectMessage[]
  feed_posts                                                 feed_posts[]
  group_audit_logs_group_audit_logs_actor_user_idTousers     group_audit_logs[]    @relation("group_audit_logs_actor_user_idTousers")
  group_audit_logs_group_audit_logs_target_user_idTousers    group_audit_logs[]    @relation("group_audit_logs_target_user_idTousers")
  memberships                                                GroupMember[]
  ownedGroups                                                Group[]               @relation("GroupOwner")
  invitationCode                                             InvitationCode?
  redemption                                                 InvitationRedemption?
  messages                                                   Message[]
  moderationActions                                          ModerationLog[]       @relation("ModerationActor")
  blocksReceived                                             UserBlock[]           @relation("Blocked")
  blocksAuthored                                             UserBlock[]           @relation("Blocker")
  followsAuthored                                            UserFollow[]          @relation("Follower")
  followsReceived                                            UserFollow[]          @relation("Following")
  user_notifications_user_notifications_actor_user_idTousers user_notifications[]  @relation("user_notifications_actor_user_idTousers")
  user_notifications_user_notifications_user_idTousers       user_notifications[]  @relation("user_notifications_user_idTousers")
  reputationReceived                                         UserReputation[]      @relation("TargetReputation")
  reputationVotes                                            UserReputation[]      @relation("VoterReputation")

  @@index([globalRole])
  @@map("users")
}

model InvitationCode {
  id          String                 @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId String                 @unique @map("owner_user_id") @db.Uuid
  code        String                 @unique @db.VarChar(6)
  usesCount   Int                    @default(0) @map("uses_count") @db.SmallInt
  maxUses     Int                    @default(3) @map("max_uses") @db.SmallInt
  isRevoked   Boolean                @default(false) @map("is_revoked")
  createdAt   DateTime               @default(now()) @map("created_at") @db.Timestamptz(6)
  owner       User                   @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  redemptions InvitationRedemption[]

  @@map("invitation_codes")
}

model InvitationRedemption {
  id               String         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invitationCodeId String         @map("invitation_code_id") @db.Uuid
  inviteeUserId    String         @unique @map("invitee_user_id") @db.Uuid
  redeemedAt       DateTime       @default(now()) @map("redeemed_at") @db.Timestamptz(6)
  ipAddress        String?        @map("ip_address") @db.Inet
  userAgent        String?        @map("user_agent")
  invitationCode   InvitationCode @relation(fields: [invitationCodeId], references: [id])
  invitee          User           @relation(fields: [inviteeUserId], references: [id], onDelete: Cascade)

  @@index([invitationCodeId])
  @@map("invitation_redemptions")
}

model AuthSession {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address") @db.Inet
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz(6)
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz(6)
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz(6)
  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

model Group {
  id               String             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId          String             @map("owner_id") @db.Uuid
  name             String             @db.VarChar(80)
  slug             String             @unique @db.VarChar(80)
  description      String?
  iconUrl          String?            @map("icon_url")
  privacy          GroupPrivacy       @default(PRIVATE)
  isDeleted        Boolean            @default(false) @map("is_deleted")
  createdAt        DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  bannerUrl        String?            @map("banner_url")
  channels         Channel[]
  group_audit_logs group_audit_logs[]
  members          GroupMember[]
  owner            User               @relation("GroupOwner", fields: [ownerId], references: [id])
  modLogs          ModerationLog[]

  @@index([ownerId])
  @@map("groups")
}

model GroupMember {
  id       String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId  String    @map("group_id") @db.Uuid
  userId   String    @map("user_id") @db.Uuid
  role     GroupRole @default(GROUP_MEMBER)
  isBanned Boolean   @default(false) @map("is_banned")
  joinedAt DateTime  @default(now()) @map("joined_at") @db.Timestamptz(6)
  group    Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId, role])
  @@map("group_members")
}

model Channel {
  id          String      @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId     String      @map("group_id") @db.Uuid
  name        String      @db.VarChar(80)
  type        ChannelType
  position    Int         @default(0)
  isEnabled   Boolean     @default(true) @map("is_enabled")
  sfuRoomId   String?     @map("sfu_room_id")
  bitrateKbps Int?        @map("bitrate_kbps")
  createdAt   DateTime    @default(now()) @map("created_at") @db.Timestamptz(6)
  group       Group       @relation(fields: [groupId], references: [id], onDelete: Cascade)
  messages    Message[]

  @@unique([groupId, name])
  @@index([groupId])
  @@map("channels")
}

model Message {
  id          String        @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  channelId   String        @map("channel_id") @db.Uuid
  authorId    String?       @map("author_id") @db.Uuid
  parentId    String?       @map("parent_id") @db.Uuid
  content     String?
  attachments Json          @default("[]")
  reactions   Json          @default("[]")
  isPinned    Boolean       @default(false) @map("is_pinned")
  isEdited    Boolean       @default(false) @map("is_edited")
  status      MessageStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt   DateTime?     @map("deleted_at") @db.Timestamptz(6)
  author      User?         @relation(fields: [authorId], references: [id])
  channel     Channel       @relation(fields: [channelId], references: [id], onDelete: Cascade)

  @@id([id, createdAt])
  @@index([channelId, createdAt])
  @@index([authorId])
  @@map("messages")
}

model UserBlock {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)
  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

model UserFollow {
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
  @@map("user_follows")
}

model DirectConversation {
  id          String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userAId     String                   @map("user_a_id") @db.Uuid
  userBId     String                   @map("user_b_id") @db.Uuid
  createdAt   DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  status      DirectConversationStatus @default(PENDING)
  initiatorId String                   @map("initiator_id") @db.Uuid
  acceptedAt  DateTime?                @map("accepted_at") @db.Timestamptz(6)
  rejectedAt  DateTime?                @map("rejected_at") @db.Timestamptz(6)
  initiator   User                     @relation("DMInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  userA       User                     @relation("DMUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB       User                     @relation("DMUserB", fields: [userBId], references: [id], onDelete: Cascade)
  messages    DirectMessage[]

  @@unique([userAId, userBId])
  @@map("direct_conversations")
}

model DirectMessage {
  id             String                @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId String                @map("conversation_id") @db.Uuid
  authorId       String?               @map("author_id") @db.Uuid
  content        String?
  attachments    Json                  @default("[]")
  status         MessageStatus         @default(PUBLISHED)
  createdAt      DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  deletedAt      DateTime?             @map("deleted_at") @db.Timestamptz(6)
  parentId       String?               @map("parent_id") @db.Uuid
  hiddenFor      DirectMessageHidden[]
  author         User?                 @relation(fields: [authorId], references: [id])
  conversation   DirectConversation    @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  parent         DirectMessage?        @relation("DMReplyChain", fields: [parentId], references: [id])
  replies        DirectMessage[]       @relation("DMReplyChain")

  @@index([conversationId, createdAt])
  @@index([parentId])
  @@map("direct_messages")
}

model DirectMessageHidden {
  messageId String        @map("message_id") @db.Uuid
  userId    String        @map("user_id") @db.Uuid
  createdAt DateTime      @default(now()) @map("created_at") @db.Timestamptz(6)
  message   DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
  @@map("direct_message_hidden")
}

model ModerationLog {
  id         BigInt           @id @default(autoincrement())
  actorId    String?          @map("actor_id") @db.Uuid
  targetType ModerationTarget @map("target_type")
  targetId   String           @map("target_id") @db.Uuid
  groupId    String?          @map("group_id") @db.Uuid
  action     ModerationAction
  reason     String?
  metadata   Json             @default("{}")
  createdAt  DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  actor      User?            @relation("ModerationActor", fields: [actorId], references: [id])
  group      Group?           @relation(fields: [groupId], references: [id])

  @@index([targetType, targetId])
  @@index([actorId])
  @@index([groupId])
  @@map("moderation_logs")
}

model UserReputation {
  voterId   String   @map("voter_id") @db.Uuid
  targetId  String   @map("target_id") @db.Uuid
  voteType  Int      @map("vote_type")
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @default(now()) @updatedAt @map("updated_at") @db.Timestamptz(6)
  target    User     @relation("TargetReputation", fields: [targetId], references: [id], onDelete: Cascade)
  voter     User     @relation("VoterReputation", fields: [voterId], references: [id], onDelete: Cascade)

  @@id([voterId, targetId])
  @@index([targetId])
  @@map("user_reputation")
}

/// This table contains check constraints and requires additional setup for migrations. Visit https://pris.ly/d/check-constraints for more info.
model feed_posts {
  id            String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  author_id     String    @db.Uuid
  content       String?   @db.VarChar(120)
  attachments   Json      @default("[]")
  created_at    DateTime  @default(now()) @db.Timestamptz(6)
  deleted_at    DateTime? @db.Timestamptz(6)
  like_user_ids Json      @default("[]")
  comments      Json      @default("[]")
  users         User      @relation(fields: [author_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([author_id], map: "idx_feed_posts_author_id")
  @@index([created_at(sort: Desc)], map: "idx_feed_posts_created_at")
}

model group_audit_logs {
  id                                           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  group_id                                     String   @db.Uuid
  actor_user_id                                String?  @db.Uuid
  target_user_id                               String?  @db.Uuid
  action                                       String
  metadata                                     Json     @default("{}")
  created_at                                   DateTime @default(now()) @db.Timestamptz(6)
  users_group_audit_logs_actor_user_idTousers  User?    @relation("group_audit_logs_actor_user_idTousers", fields: [actor_user_id], references: [id], onUpdate: NoAction)
  groups                                       Group    @relation(fields: [group_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  users_group_audit_logs_target_user_idTousers User?    @relation("group_audit_logs_target_user_idTousers", fields: [target_user_id], references: [id], onUpdate: NoAction)

  @@index([group_id, created_at(sort: Desc)], map: "idx_group_audit_logs_group_created")
}

model user_notifications {
  id                                            String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                                       String   @db.Uuid
  actor_user_id                                 String?  @db.Uuid
  kind                                          String   @db.VarChar(32)
  title                                         String   @db.VarChar(160)
  body                                          String   @db.VarChar(240)
  post_id                                       String?  @db.Uuid
  is_read                                       Boolean  @default(false)
  created_at                                    DateTime @default(now()) @db.Timestamptz(6)
  users_user_notifications_actor_user_idTousers User?    @relation("user_notifications_actor_user_idTousers", fields: [actor_user_id], references: [id], onUpdate: NoAction)
  users_user_notifications_user_idTousers       User     @relation("user_notifications_user_idTousers", fields: [user_id], references: [id], onDelete: Cascade, onUpdate: NoAction)

  @@index([user_id, created_at(sort: Desc)], map: "idx_user_notifications_user_created")
  @@index([user_id, is_read], map: "idx_user_notifications_user_unread")
}

enum GlobalRole {
  SUPER_ADMIN
  GLOBAL_MODERATOR
  USER
}

enum GroupRole {
  GROUP_ADMIN
  GROUP_MODERATOR
  GROUP_MEMBER
}

enum ChannelType {
  TEXT
  VOICE
  VIDEO
}

enum GroupPrivacy {
  PUBLIC_INVITE
  PRIVATE
  SECRET
}

enum ModerationAction {
  SOFT_DELETE
  HARD_DELETE
  BAN
  UNBAN
  MUTE
  KICK
  NSFW_BLOCK
  EDIT_REVERT
  REPORT
}

enum ModerationTarget {
  USER
  MESSAGE
  GROUP
  CHANNEL
  FILE
}

enum MessageStatus {
  PENDING_MODERATION
  PUBLISHED
  BLOCKED
  DELETED
}

enum DirectConversationStatus {
  PENDING
  ACCEPTED
  REJECTED
}
