// Prisma schema — mirrors the PostgreSQL DDL.
// Note: native PG features used via raw SQL migrations (partitioning, CHECKs).

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["postgresqlExtensions"]
}

datasource db {
  provider   = "postgresql"
  url        = env("DATABASE_URL")
  extensions = [pgcrypto, citext, pg_trgm]
}

// =========================================================
// ENUMS
// =========================================================
enum GlobalRole {
  SUPER_ADMIN
  GLOBAL_MODERATOR
  USER
}

enum GroupRole {
  GROUP_ADMIN
  GROUP_MODERATOR
  GROUP_MEMBER
}

enum ChannelType {
  TEXT
  VOICE
  VIDEO
}

enum GroupPrivacy {
  PUBLIC_INVITE
  PRIVATE
  SECRET
}

enum ModerationAction {
  SOFT_DELETE
  HARD_DELETE
  BAN
  UNBAN
  MUTE
  KICK
  NSFW_BLOCK
  EDIT_REVERT
  REPORT
}

enum ModerationTarget {
  USER
  MESSAGE
  GROUP
  CHANNEL
  FILE
}

enum MessageStatus {
  PENDING_MODERATION
  PUBLISHED
  BLOCKED
  DELETED
}

enum DirectConversationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

// =========================================================
// USERS
// =========================================================
model User {
  id                   String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  email                String     @unique @db.Citext
  passwordHash         String     @map("password_hash")
  legalNameEncrypted   Bytes?     @map("legal_name_encrypted")
  dateOfBirth          DateTime   @map("date_of_birth") @db.Date
  displayName          String     @map("display_name") @db.VarChar(40)
  avatarUrl            String?    @map("avatar_url")
  isAnonymousProfile   Boolean    @default(false) @map("is_anonymous_profile")
  globalRole           GlobalRole @default(USER) @map("global_role")
  isVerifiedModerator  Boolean    @default(false) @map("is_verified_moderator")
  isBanned             Boolean    @default(false) @map("is_banned")
  bannedReason         String?    @map("banned_reason")
  createdAt            DateTime   @default(now()) @map("created_at") @db.Timestamptz
  updatedAt            DateTime   @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt            DateTime?  @map("deleted_at") @db.Timestamptz

  invitationCode       InvitationCode?
  redemption           InvitationRedemption?
  sessions             AuthSession[]
  ownedGroups          Group[]               @relation("GroupOwner")
  memberships          GroupMember[]
  messages             Message[]
  blocksAuthored       UserBlock[]           @relation("Blocker")
  blocksReceived       UserBlock[]           @relation("Blocked")
  followsAuthored      UserFollow[]          @relation("Follower")
  followsReceived      UserFollow[]          @relation("Following")
  dmA                  DirectConversation[]  @relation("DMUserA")
  dmB                  DirectConversation[]  @relation("DMUserB")
  dmRequestsStarted    DirectConversation[]  @relation("DMInitiator")
  directMessages       DirectMessage[]
  hiddenDirectMessages DirectMessageHidden[]
  moderationActions    ModerationLog[]       @relation("ModerationActor")

  @@index([globalRole])
  @@map("users")
}

// =========================================================
// INVITATION CODES (1:1 with user; max_uses = 3)
// =========================================================
model InvitationCode {
  id          String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerUserId String   @unique @map("owner_user_id") @db.Uuid
  code        String   @unique @db.VarChar(6)
  usesCount   Int      @default(0) @map("uses_count") @db.SmallInt
  maxUses     Int      @default(3) @map("max_uses") @db.SmallInt
  isRevoked   Boolean  @default(false) @map("is_revoked")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  owner       User                    @relation(fields: [ownerUserId], references: [id], onDelete: Cascade)
  redemptions InvitationRedemption[]

  @@map("invitation_codes")
}

model InvitationRedemption {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  invitationCodeId   String   @map("invitation_code_id") @db.Uuid
  inviteeUserId      String   @unique @map("invitee_user_id") @db.Uuid
  redeemedAt         DateTime @default(now()) @map("redeemed_at") @db.Timestamptz
  ipAddress          String?  @map("ip_address") @db.Inet
  userAgent          String?  @map("user_agent")

  invitationCode     InvitationCode @relation(fields: [invitationCodeId], references: [id], onDelete: Restrict)
  invitee            User           @relation(fields: [inviteeUserId], references: [id], onDelete: Cascade)

  @@index([invitationCodeId])
  @@map("invitation_redemptions")
}

// =========================================================
// AUTH SESSIONS (refresh token rotation)
// =========================================================
model AuthSession {
  id               String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           String    @map("user_id") @db.Uuid
  refreshTokenHash String    @map("refresh_token_hash")
  userAgent        String?   @map("user_agent")
  ipAddress        String?   @map("ip_address") @db.Inet
  expiresAt        DateTime  @map("expires_at") @db.Timestamptz
  revokedAt        DateTime? @map("revoked_at") @db.Timestamptz
  createdAt        DateTime  @default(now()) @map("created_at") @db.Timestamptz

  user             User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("auth_sessions")
}

// =========================================================
// GROUPS
// =========================================================
model Group {
  id          String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  ownerId     String       @map("owner_id") @db.Uuid
  name        String       @db.VarChar(80)
  slug        String       @unique @db.VarChar(80)
  description String?
  iconUrl     String?      @map("icon_url")
  privacy     GroupPrivacy @default(PRIVATE)
  isDeleted   Boolean      @default(false) @map("is_deleted")
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime     @updatedAt @map("updated_at") @db.Timestamptz

  owner       User          @relation("GroupOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  members     GroupMember[]
  channels    Channel[]
  modLogs     ModerationLog[]

  @@index([ownerId])
  @@map("groups")
}

model GroupMember {
  id        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId   String    @map("group_id") @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  role      GroupRole @default(GROUP_MEMBER)
  isBanned  Boolean   @default(false) @map("is_banned")
  joinedAt  DateTime  @default(now()) @map("joined_at") @db.Timestamptz

  group     Group     @relation(fields: [groupId], references: [id], onDelete: Cascade)
  user      User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([groupId, userId])
  @@index([userId])
  @@index([groupId, role])
  @@map("group_members")
}

// =========================================================
// CHANNELS
// =========================================================
model Channel {
  id           String       @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  groupId      String       @map("group_id") @db.Uuid
  name         String       @db.VarChar(80)
  type         ChannelType
  position     Int          @default(0)
  isEnabled    Boolean      @default(true) @map("is_enabled")
  sfuRoomId    String?      @map("sfu_room_id")
  bitrateKbps  Int?         @map("bitrate_kbps")
  createdAt    DateTime     @default(now()) @map("created_at") @db.Timestamptz

  group        Group        @relation(fields: [groupId], references: [id], onDelete: Cascade)
  messages     Message[]

  @@unique([groupId, name])
  @@index([groupId])
  @@map("channels")
}

// =========================================================
// MESSAGES (partitioned by created_at in raw migration)
// =========================================================
model Message {
  id          String        @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  channelId   String        @map("channel_id") @db.Uuid
  authorId    String?       @map("author_id") @db.Uuid
  parentId    String?       @map("parent_id") @db.Uuid
  content     String?
  attachments Json          @default("[]")
  reactions   Json          @default("[]")
  isPinned    Boolean       @default(false) @map("is_pinned")
  isEdited    Boolean       @default(false) @map("is_edited")
  status      MessageStatus @default(PUBLISHED)
  createdAt   DateTime      @default(now()) @map("created_at") @db.Timestamptz
  updatedAt   DateTime      @updatedAt @map("updated_at") @db.Timestamptz
  deletedAt   DateTime?     @map("deleted_at") @db.Timestamptz

  channel     Channel       @relation(fields: [channelId], references: [id], onDelete: Cascade)
  author      User?         @relation(fields: [authorId], references: [id], onDelete: SetNull)

  @@id([id, createdAt])
  @@index([channelId, createdAt])
  @@index([authorId])
  @@map("messages")
}

// =========================================================
// USER BLOCKS
// =========================================================
model UserBlock {
  blockerId String   @map("blocker_id") @db.Uuid
  blockedId String   @map("blocked_id") @db.Uuid
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  blocker   User     @relation("Blocker", fields: [blockerId], references: [id], onDelete: Cascade)
  blocked   User     @relation("Blocked", fields: [blockedId], references: [id], onDelete: Cascade)

  @@id([blockerId, blockedId])
  @@index([blockedId])
  @@map("user_blocks")
}

model UserFollow {
  followerId  String   @map("follower_id") @db.Uuid
  followingId String   @map("following_id") @db.Uuid
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz

  follower    User     @relation("Follower", fields: [followerId], references: [id], onDelete: Cascade)
  following   User     @relation("Following", fields: [followingId], references: [id], onDelete: Cascade)

  @@id([followerId, followingId])
  @@index([followingId])
  @@map("user_follows")
}

// =========================================================
// DIRECT MESSAGES (1:1)
// =========================================================
model DirectConversation {
  id        String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userAId   String   @map("user_a_id") @db.Uuid
  userBId   String   @map("user_b_id") @db.Uuid
  initiatorId String @map("initiator_id") @db.Uuid
  status    DirectConversationStatus @default(PENDING)
  acceptedAt DateTime? @map("accepted_at") @db.Timestamptz
  rejectedAt DateTime? @map("rejected_at") @db.Timestamptz
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz

  userA     User              @relation("DMUserA", fields: [userAId], references: [id], onDelete: Cascade)
  userB     User              @relation("DMUserB", fields: [userBId], references: [id], onDelete: Cascade)
  initiator User              @relation("DMInitiator", fields: [initiatorId], references: [id], onDelete: Cascade)
  messages  DirectMessage[]

  @@unique([userAId, userBId])
  @@map("direct_conversations")
}

model DirectMessage {
  id              String        @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversationId  String        @map("conversation_id") @db.Uuid
  authorId        String?       @map("author_id") @db.Uuid
  parentId        String?       @map("parent_id") @db.Uuid
  content         String?
  attachments     Json          @default("[]")
  status          MessageStatus @default(PUBLISHED)
  createdAt       DateTime      @default(now()) @map("created_at") @db.Timestamptz
  deletedAt       DateTime?     @map("deleted_at") @db.Timestamptz

  conversation    DirectConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  author          User?              @relation(fields: [authorId], references: [id], onDelete: SetNull)
  parent          DirectMessage?     @relation("DMReplyChain", fields: [parentId], references: [id], onDelete: SetNull)
  replies         DirectMessage[]    @relation("DMReplyChain")
  hiddenFor       DirectMessageHidden[]

  @@index([conversationId, createdAt])
  @@index([parentId])
  @@map("direct_messages")
}

model DirectMessageHidden {
  messageId  String   @map("message_id") @db.Uuid
  userId     String   @map("user_id") @db.Uuid
  createdAt  DateTime @default(now()) @map("created_at") @db.Timestamptz

  message    DirectMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  user       User          @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([messageId, userId])
  @@index([userId])
  @@map("direct_message_hidden")
}

// =========================================================
// MODERATION LOGS
// =========================================================
model ModerationLog {
  id          BigInt           @id @default(autoincrement())
  actorId     String?          @map("actor_id") @db.Uuid
  targetType  ModerationTarget @map("target_type")
  targetId    String           @map("target_id") @db.Uuid
  groupId     String?          @map("group_id") @db.Uuid
  action      ModerationAction
  reason      String?
  metadata    Json             @default("{}")
  createdAt   DateTime         @default(now()) @map("created_at") @db.Timestamptz

  actor       User?            @relation("ModerationActor", fields: [actorId], references: [id], onDelete: SetNull)
  group       Group?           @relation(fields: [groupId], references: [id], onDelete: SetNull)

  @@index([targetType, targetId])
  @@index([actorId])
  @@index([groupId])
  @@map("moderation_logs")
}
